# --- Restos de WordPress (categorias, feeds, wp-*) -> blog / home ---
Redirect 301 /category/concrete/ /blog/
Redirect 301 /category/hardscaping/ /blog/
Redirect 301 /category/permits-hoa-codes/ /blog/
Redirect 301 /blog/feed/ /blog/
Redirect 301 /blog/comments/feed/ /blog/
RedirectMatch 301 ^/blog/wp-.*$ /blog/
RedirectMatch 301 ^/wp-.*$ /
RedirectMatch 301 ^/feed/?$ /blog/
RedirectMatch 301 ^/(.+)/feed/?$ /$1/

# --- 404 bonito para o que sobrar ---
ErrorDocument 404 /404.html
