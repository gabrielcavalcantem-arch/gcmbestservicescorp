# GCM Best Services Corp — redirecionamentos 301 do site antigo (WordPress/Manus) para o site atual
# Gerado em 31/10/2026 a partir do relatório "Não encontrado (404)" do Search Console (69 URLs)
# Hostinger (LiteSpeed) lê este arquivo em public_html. Manter no topo de qualquer .htaccess existente.

RewriteEngine On

# --- HTTPS + sem www (canônico) ---
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://gcmbestservicescorp.com/$1 [L,R=301]

# --- Páginas institucionais antigas ---
Redirect 301 /home/ /
Redirect 301 /reviews/ /about/
Redirect 301 /privacy-policy/ /terms-conditions/
Redirect 301 /_preview/ /

# --- Serviços antigos -> serviços atuais ---
Redirect 301 /services/pavers /pavers/
Redirect 301 /pavers-orlando /pavers/
Redirect 301 /pavers-orlando/ /pavers/
Redirect 301 /concrete-orlando /concrete/
Redirect 301 /concrete-orlando/ /concrete/
Redirect 301 /services/outdoor-living /patios/
Redirect 301 /hardscape/ /pavers/
Redirect 301 /hardscaping/ /pavers/
Redirect 301 /brick-paver-hardscape/ /pavers/
Redirect 301 /epoxy-coating/ /concrete/
Redirect 301 /services/epoxy/st-cloud /concrete/
Redirect 301 /services/epoxy/davenport /concrete/
Redirect 301 /services/epoxy/kissimmee /concrete/
Redirect 301 /services/concrete/davenport /concrete/

# --- Cidades antigas -> áreas atuais ---
